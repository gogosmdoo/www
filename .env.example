# Canonical origin. Everything absolute on the site derives from this:
# canonical, og:url, hreflang, JSON-LD @id, sitemap.xml.
# No trailing slash. Must match the domain users actually land on.
# On Cloudflare Pages set this in: Project -> Settings -> Environment variables
# (set it for BOTH Production and Preview).
#
# TODO(client): the domain below is a placeholder and has not been confirmed.
# A wrong value here is a sitewide SEO failure, not a local one.
NUXT_PUBLIC_SITE_URL=https://rentacargogo.ba

# Web3Forms access key for the contact form.
# Get it free at https://web3forms.com — the key arrives by email and
# submissions are forwarded to whatever inbox you register.
#
# TODO(client): no reservations inbox has been supplied. Until one is, leave
# this empty: the contact form then hands the typed enquiry to WhatsApp rather
# than to a mail client, which is where this agency answers anyway.
NUXT_PUBLIC_WEB3FORMS_KEY=

# Analytics. Set ONE of the two below, not both.
#
# Plausible: cookieless, ~1 KB, no consent banner needed. Paid.
# Value is the domain as registered in Plausible, e.g. rentacargogo.ba
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=

# GA4: free and joins up with Search Console and Google Ads, but sets cookies.
# Choosing this means a consent banner is required for EU visitors, and this
# site does not have one yet. Value looks like G-XXXXXXXXXX
NUXT_PUBLIC_GA_ID=

# With neither set, no analytics script is loaded and no event is sent.
