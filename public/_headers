# Cloudflare Pages headers. Copied to the root of the build output.
#
# There is deliberately NO X-Robots-Tag here. This file ships to production and
# a stray noindex would quietly de-list the whole site. If you need a private
# client preview, add the noindex to that deploy only — never here.

# Hashed build assets: the filename changes whenever the content does, so these
# can be cached forever.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Images and fonts are NOT content-hashed — a vehicle photo keeps its filename
# when it is replaced. A month is long enough to matter for a returning visitor
# and short enough that swapping a photo does not need a cache purge.
/images/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=2592000

# Regenerated on every deploy, so they must not be held for long.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
